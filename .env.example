# DeepFocusAI — Environment Variables
# ─────────────────────────────────────
# Copy this file to .env.local for local dev
# Add these variables in your Vercel project dashboard

# 1. Google Gemini API key (FREE — 1500 req/day)
#    Get it at: https://aistudio.google.com/app/apikey
#    Click "Create API Key" — takes 30 seconds
GEMINI_API_KEY=AIza...

# 2. YouTube Data API v3 key (for music search)
#    Get it at: https://console.cloud.google.com
#    → APIs & Services → Credentials → Create API Key
#    → Enable "YouTube Data API v3"
#    Free quota: 10,000 requests/day
YOUTUBE_API_KEY=AIza...
